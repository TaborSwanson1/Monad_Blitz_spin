# "sim" runs a fake chain in the browser. "chain" talks to Monad testnet.
VITE_MODE=sim

# Sim mode follows live Monad testnet blocks for its clock and block display
# (results still come from the browser's random generator, never from blocks).
# Set VITE_LIVE_BLOCKS=off for a fully offline simulator.
VITE_LIVE_BLOCKS=on
VITE_LIVE_BLOCKS_WS=wss://testnet-rpc.monad.xyz

# Only needed in chain mode. Check Monad's docs for current values.
VITE_CHAIN_ID=10143
VITE_RPC_HTTP=https://testnet-rpc.monad.xyz
VITE_RPC_WS=
VITE_CASINO_ADDRESS=
VITE_CHIP_ADDRESS=
