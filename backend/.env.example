# Copy to backend/.env (git-ignored). No secrets belong in this example file.

# Monad testnet, chain ID 10143. Verified against docs.monad.xyz on 2026-11-15.
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Pyth Entropy on Monad testnet. Verified against docs.pyth.network/entropy/chainlist
# and on-chain on 2026-11-15. Leave empty to deploy MockRandomness (local anvil only).
PYTH_ENTROPY_ADDRESS=0x825c0390f379c631f3cf11a82a37d20bddf93c07

# The deployer key is NOT stored here. Import it once into Foundry's encrypted keystore:
#   cast wallet import monad-deployer --interactive
# then deploy with:  --account monad-deployer
