{
  "name": "block-casino-backend",
  "private": true,
  "type": "module",
  "description": "Foundry project + scripts that translate the backend for the frontend. Run `npm install` once.",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "dev": "bash scripts/dev.sh",
    "export": "forge build --silent && node scripts/export.mjs",
    "check-seam": "forge build --silent && node scripts/check-seam.mjs",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "vectors": "node scripts/seed-vectors.mjs",
    "wallet:build": "node wallet/build.mjs",
    "test:wallet": "node wallet/build.mjs && node --test wallet/test/e2e.test.mjs"
  },
  "devDependencies": {
    "@pythnetwork/entropy-sdk-solidity": "2.2.1",
    "esbuild": "0.24.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "typescript": "5.6.3",
    "viem": "2.21.54"
  }
}
